# Supabase — public (browser-safe) values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key (server-only, RLS-bypassing; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used to build the Google OAuth callback URL (/auth/callback).
# Optional locally — the request host is used when unset — but required behind a
# proxy or on preview/production deploys. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment/KYC provider selection: "mock" (deterministic simulation) or "pinch" (real Pinch Payments API)
PAYMENTS_PROVIDER=mock

# --- Pinch Payments (only needed when PAYMENTS_PROVIDER=pinch) ---
# Which Pinch environment to talk to: test (default) or live.
PINCH_ENV=test

# Application ID + Secret Key from https://web.getpinch.com.au/api-keys (server-only).
# Test credentials:
PINCH_DEV_ID=
PINCH_DEV_SECRET=
# Live credentials:
PINCH_LIVE_ID=
PINCH_LIVE_SECRET=

# CaptureJS publishable keys (pk_test_... / pk_live_...). Browser-safe; returned
# to the client by the getTokenisationConfig server action.
PINCH_TEST_PUBLISHABLE_KEY=
PINCH_PUBLISHABLE_KEY=

# whsec_... secret shown when you create the webhook in the Pinch portal. Used to
# verify the `pinch-signature` header on inbound deliveries.
PINCH_WEBHOOK_SECRET=

# Identity verification while on real Pinch payments: "mock" (default —
# deterministic KYC, real Pinch Payer records) or "provider" (reserved for the
# real Glassbox integration).
PINCH_KYC_MODE=mock

# The platform's own (parent) merchant, used as the default Current-Merchant.
# Sub-merchant charges override it per request.
PINCH_MERCHANT_ID=

# --- Pinch test-mode simulation (ignored entirely when PINCH_ENV=live) ---
# Time-Travel: makes the Pinch TEST environment treat every request as if it
# arrived at this instant, so overnight direct-debit processing and settlement
# happen immediately instead of over days. ISO-8601, e.g. 2026-08-01T09:45:59Z.
PINCH_TIME_TRAVEL=

# Force test payments to fail with a specific dishonour code (without the leading
# '#'), e.g. insufficient-funds. Exercises the HOLDS_FAILED / transfer-failed
# compensating paths against the real API. Leave blank for normal approvals.
PINCH_TEST_DISHONOUR_CODE=

# Allow the app to deliver a signed `compliance-updated` webhook to itself so a
# Managed Merchant approval/rejection can be demoed without waiting for Pinch's
# human compliance review. Test mode only; set to "false" to disable.
PINCH_SIMULATE_COMPLIANCE=true

# Where Cash_Sale funds land:
#   platform (default) — collect into the platform merchant; sellers are paid out of band.
#   direct             — collect into the seller's own sub-merchant, with the flat
#                        platform fee retained as an application fee. Requires the
#                        seller to be an approved, settlement-enabled sub-merchant.
PAYOUT_MODE=platform

# Shared secret used to sign/verify webhook payloads (HMAC)
WEBHOOK_SECRET=

# URL the MockService POSTs simulated webhook events to (e.g. http://localhost:3000/api/webhooks/pinch)
WEBHOOK_URL=
