{
  "name": "cardtrade",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:db:reset": "node scripts/dev/resetDevSchema.mjs",
    "dev:db:apply": "node scripts/dev/applyToDev.mjs",
    "dev:stripe": "node scripts/dev/stripeListen.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:db": "vitest --run --project database",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:build": "node scripts/e2e/build-for-e2e.mjs",
    "test:e2e:clean": "npm run audit:clean --",
    "test:e2e:killserver": "node scripts/e2e/kill-dev-server.mjs",
    "audit": "node scripts/e2e/audit.mjs",
    "audit:report": "tsx --env-file=.env.local scripts/e2e/audit-report.ts",
    "audit:pack": "tsx scripts/e2e/audit-pack.ts",
    "audit:reel": "tsx scripts/e2e/highlight-reel.ts",
    "audit:clean": "tsx scripts/e2e/cleanup-test-data.ts",
    "audit:stripe-fixtures": "tsx scripts/e2e/provision-stripe-fixtures.ts",
    "audit:mobile": "tsx scripts/mobile-api-audit.ts",
    "generate:dart-vocab": "tsx scripts/generate-dart-vocabulary.ts",
    "generate:mobile-tokens": "tsx scripts/generate-mobile-tokens.ts",
    "smoke:mobile": "tsx --env-file=.env.local scripts/smoke-mobile-api.ts",
    "smoke:stripe": "tsx --env-file=.env.local scripts/smoke-stripe-test.ts",
    "smoke:stripe:refund": "tsx --env-file=.env.local scripts/smoke-stripe-refund.ts",
    "smoke:stripe:us": "tsx --env-file=.env.local scripts/smoke-stripe-test.ts US",
    "smoke:stripe:connect": "tsx --env-file=.env.local scripts/smoke-stripe-connect.ts",
    "smoke:stripe:connect:us": "tsx --env-file=.env.local scripts/smoke-stripe-connect.ts US",
    "smoke:stripe:bank-rails": "tsx --env-file=.env.local scripts/smoke-stripe-bank-rails.ts",
    "verify:regions": "tsx --env-file=.env.local scripts/verify-stripe-region.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1129.0",
    "@aws-sdk/client-sesv2": "^3.1129.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@stripe/react-stripe-js": "6.8.0",
    "@stripe/stripe-js": "9.12.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.0",
    "next": "^16.3.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/eslint-plugin-next": "16.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.10",
    "typescript": "^5.7.3",
    "vercel": "^54.17.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
